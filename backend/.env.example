DB_NAME=martini_cell
DB_USER=martini_app
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Separar varios orígenes con coma. En producción configurar solo el dominio real.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
# En el host, definir una ruta ABSOLUTA en un volumen privado y persistente.
# DJANGO_PRIVATE_MEDIA_ROOT=/ruta/privada/martini-cell
