DB_NAME=martini_cell
DB_USER=martini_app
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432
# Si PostgreSQL está fuera del host, configurar TLS según el proveedor.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/ruta/privada/ca-postgres.pem
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Separar varios orígenes con coma. En producción configurar solo el dominio real.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
# En producción HTTPS, tras verificar que el proxy sobrescribe el encabezado.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_HSTS_SECONDS=0
# Si se activan correos de la aplicación, configurar el SMTP real en el host.
# DJANGO_SMTP_HOST=smtp.example.com
# DJANGO_SMTP_PORT=587
# DJANGO_SMTP_USERNAME=
# DJANGO_SMTP_PASSWORD=
# DJANGO_SMTP_USE_TLS=true
# En el host, definir una ruta ABSOLUTA en un volumen privado y persistente.
# DJANGO_PRIVATE_MEDIA_ROOT=/ruta/privada/martini-cell

# WhatsApp Cloud API (Meta)
# Mantener desactivada hasta configurar la cuenta de Meta y las plantillas aprobadas.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
# Definir la versión de Graph API habilitada para la aplicación de Meta.
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# SECRETO: definir solo en el .env real / variables del host. Nunca subir a Git.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_TIMEOUT=10
# Idioma y nombres EXACTOS de las plantillas aprobadas en WhatsApp Manager.
WHATSAPP_TEMPLATE_LANGUAGE=es_CL
WHATSAPP_TEMPLATE_RECEPTION=
WHATSAPP_TEMPLATE_CHAT_REPLY=
WHATSAPP_TEMPLATE_STATUS_CHANGE=
# Durante la transición permite conservar el flujo manual wa.me como respaldo.
WHATSAPP_CLOUD_FALLBACK_TO_WA_ME=true
